{
  "manifest_version": 3,
  "name": "Cristal Clear Xuper IPTV",
  "version": "0.2.0",
  "description": "Televisión en español por país y categoría, con guía XMLTV.",
  "action": {
    "default_title": "Abrir Clear Xuper TV"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://iptv-org.github.io/*"
  ],
  "icons": {
    "192": "icon-192.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self' blob:"
  }
}